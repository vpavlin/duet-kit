#!/usr/bin/env python3
"""Print the short name (cz/us) of the layout on the real keyboards, ignoring virtual ones
(the on-screen keyboard reports layout 'wvkbd', which blanked the sway/language indicator)."""
import json, subprocess
try:
    inputs = json.loads(subprocess.run(["swaymsg", "-t", "get_inputs", "-r"], capture_output=True, text=True).stdout)
except ValueError:
    inputs = []
SHORT = {"Czech": "cz", "English (US)": "us"}
for i in inputs:
    name = i.get("xkb_active_layout_name")
    if i.get("type") == "keyboard" and name and "virtual" not in i.get("identifier", "") and name != "wvkbd":
        print(SHORT.get(name, name[:2].lower()))
        break
