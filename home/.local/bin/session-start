#!/bin/sh
# Hand Sway's display to systemd, then start the session apps (basecamp, brave, foot).
systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP XDG_SESSION_ID XDG_SEAT DESKTOP_SESSION
systemctl --user start sway-session.target
