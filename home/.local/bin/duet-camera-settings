#!/usr/bin/env python3
# Camera Settings for the Lenovo Duet: live preview, PipeWire image controls
# (contrast / saturation / gamma), rear lens focus, histogram + clipping zebra.
# The preview is an ordinary PipeWire client, so it shares the camera with
# Brave. Controls are set on the libcamera PipeWire node, so every client of
# that camera sees them.
import datetime, glob, json, os, re, shutil, subprocess, sys, threading, time
import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
gi.require_version("Gst", "1.0")
from gi.repository import Adw, Gdk, Gio, GLib, Gst, Gtk
import math

# The camera PipeWire instance is a second socket, video only.
os.environ.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
os.environ.setdefault("PIPEWIRE_REMOTE", "pipewire-0")
Gst.init(None)

CONFIG = os.path.expanduser("~/.config/duet-camera-app/settings.json")
CAMERAS = {"front": ("ov02a10", "Front"), "rear": ("ov8856", "Rear")}
DEFAULTS = {"contrast": 1.0, "saturation": 1.0, "gamma": 2.2}
RANGES = {"contrast": (0.0, 2.0), "saturation": (0.0, 2.0), "gamma": (0.1, 4.0)}
# libcamera's driver parks the lens here when the rear sensor starts streaming.
FOCUS_DEFAULT, FOCUS_NEAR, FOCUS_FAR = 330, 600, 250
GRID_W = 64            # analysis grid width in pixels (height follows aspect)
ANALYSIS_FPS = 5
CLIP_HI, CLIP_LO = 250, 5
FPS_CHOICES = [15, 30]

CSS = """
window { background: #07090b; }
