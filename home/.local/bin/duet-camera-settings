#focus scale highlight { background: #5aa9ff; }
button.cs-btn { background: #1c2229; color: #d6dde3; border-radius: 99px;
  padding: 10px 22px; min-height: 28px; font-weight: bold; border: none; box-shadow: none; }
button.cs-btn:checked { background: #35f0a0; color: #07090b; }
button.cs-reset { color: #6b7680; }
