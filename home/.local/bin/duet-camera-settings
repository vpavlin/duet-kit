.cs-value { color: #6b7680; font-family: monospace; min-width: 64px; }
.cs-status { color: #6b7680; font-size: 9pt; }
.cs-section { color: #6b7680; font-size: 9pt; font-weight: bold; }
scale trough { background: #1c2229; min-height: 8px; border-radius: 99px; }
scale slider { background: #d6dde3; min-width: 28px; min-height: 28px; border-radius: 99px; }
#contrast .cs-name, #contrast .cs-value { color: #f0b429; }
#contrast scale highlight { background: #f0b429; }
#saturation .cs-name, #saturation .cs-value { color: #ff6fb5; }
