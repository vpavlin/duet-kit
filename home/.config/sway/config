# Duet: one fullscreen-ish app per workspace, touch-first, nothing else.
set $mod Mod4
output DSI-1 transform 270 scale 1.25 bg #07090b solid_color
input type:touch map_to_output DSI-1
input type:tablet_tool map_to_output DSI-1
input type:keyboard {
    xkb_layout cz,us
    xkb_options grp:alt_shift_toggle
}
input type:touchpad {
    tap enabled
    natural_scroll enabled
}

default_border none
default_floating_border none
hide_edge_borders both
gaps inner 0
font pango:sans 11
focus_follows_mouse no

workspace_layout default
set $ws1 "1:Basecamp"
set $ws2 "2:Web"
set $ws3 "3:Term"

for_window [app_id="brave-browser"] move container to workspace $ws2, workspace $ws2
for_window [app_id="foot"] move container to workspace $ws3, workspace $ws3
for_window [app_id="logos-basecamp"] move container to workspace $ws1

# on-screen keyboard: shown when the keyboard cover is folded away / detached
exec ~/.local/bin/osk
bindswitch --reload --locked tablet:on exec pkill -USR2 wvkbd-mobintl
bindswitch --reload --locked tablet:off exec ~/.local/bin/osk

exec ~/.local/bin/autorotate
exec ~/.local/bin/kbd-layout-keeper
exec mako
exec ~/.local/bin/idle-dim
exec nm-applet --indicator
exec blueman-applet

# keyboard cover shortcuts
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Return exec foot
bindsym $mod+d exec ~/.local/bin/duet-launcher
bindsym $mod+q kill
bindsym $mod+Tab focus right
bindsym Mod1+Tab workspace next_on_output
bindsym Mod1+Shift+Tab workspace prev_on_output
bindsym $mod+Shift+c reload
bindsym Print exec ~/.local/bin/screenshot
bindsym $mod+s exec ~/.local/bin/screenshot
bindsym $mod+Shift+e exec ~/.local/bin/session-stop
bindsym XF86MonBrightnessUp exec brightnessctl set +10%
bindsym XF86MonBrightnessDown exec brightnessctl set 10%-
bindsym XF86AudioRaiseVolume exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec pactl set-sink-volume @DEFAULT_SINK@ -5%

workspace $ws2

include /etc/sway/config.d/*
exec ~/.local/bin/app-tabs
exec ~/.local/bin/session-start

# dialogs that sway floats get a visible border
for_window [floating] border pixel 3
# popup panels: always floating, centred on the screen
for_window [app_id="duet\\.(wifi|bluetooth|quicksettings|display|launcher)"] floating enable, move position center
client.focused #35f0a0 #0e1216 #d6dde3 #ff6fb5 #35f0a0
client.focused_inactive #1c2229 #0e1216 #6b7680 #1c2229 #1c2229
client.unfocused #1c2229 #07090b #6b7680 #1c2229 #1c2229

# projector mirror (wl-mirror): full screen on the external output, never takes keyboard focus
for_window [app_id="at.yrlf.wl_mirror"] no_focus, border none
no_focus [app_id="at.yrlf.wl_mirror"]

# touchpad: 3-finger swipe switches workspace
bindgesture swipe:3:right workspace prev_on_output
bindgesture swipe:3:left workspace next_on_output

# keyboard top row (Chromebook layout; the keys send plain F1-F10 and F13)
bindsym F1 exec wtype -M alt -k Left -m alt
bindsym F2 exec wtype -M alt -k Right -m alt
bindsym F3 exec wtype -M ctrl -k r -m ctrl
bindsym F4 fullscreen toggle
bindsym F5 workspace next_on_output
bindsym F6 exec brightnessctl set 10%-
bindsym F7 exec brightnessctl set +10%
bindsym F8 exec pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym F9 exec pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym F10 exec pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym F13 exec systemctl suspend

# Search+F1..F10 = the real function keys (like ChromeOS); sway has no bindings in this mode
mode "fkey" {
    # sway drops an empty mode block, so give it one binding nothing will press
    bindsym Mod4+Mod1+Shift+Control+F12 nop
}
bindsym $mod+F1 exec ~/.local/bin/fkey 1
bindsym $mod+F2 exec ~/.local/bin/fkey 2
bindsym $mod+F3 exec ~/.local/bin/fkey 3
bindsym $mod+F4 exec ~/.local/bin/fkey 4
bindsym $mod+F5 exec ~/.local/bin/fkey 5
bindsym $mod+F6 exec ~/.local/bin/fkey 6
bindsym $mod+F7 exec ~/.local/bin/fkey 7
bindsym $mod+F8 exec ~/.local/bin/fkey 8
bindsym $mod+F9 exec ~/.local/bin/fkey 9
bindsym $mod+F10 exec ~/.local/bin/fkey 10
