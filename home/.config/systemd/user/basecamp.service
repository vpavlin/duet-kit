[Unit]
Description=Logos Basecamp
PartOf=sway-session.target
After=sway-session.target

[Service]
# trust the LAN repo on jimmy-crib (self-signed) on top of the system CAs
Environment=CURL_CA_BUNDLE=%h/.local/share/certs/basecamp-ca-bundle.pem
Environment=SSL_CERT_FILE=%h/.local/share/certs/basecamp-ca-bundle.pem
ExecStart=%h/Apps/Basecamp.AppImage
Restart=always
RestartSec=3

[Install]
WantedBy=sway-session.target
