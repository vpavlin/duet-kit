[Unit]
Description=Local web server for the Duet's own pages (camera), localhost only
PartOf=sway-session.target
After=sway-session.target

[Service]
WorkingDirectory=/
ExecStart=/usr/bin/python3 -I -m http.server 8765 --bind 127.0.0.1 --directory %h/.local/share/duet
Restart=on-failure
RestartSec=3

[Install]
WantedBy=sway-session.target
